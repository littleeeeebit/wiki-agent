{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window loads the Python server's page, so IPC is opened to that origin and no other.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "allow-pty-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-close"
  ]
}
