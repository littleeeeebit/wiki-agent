     "spans": null,
     "cached": false,
     "request": null
    },
    {
     "text": "## Rota\n\nThe Atlas team is on call every Tuesday and handles incidents for everything it owns.",
     "status": "original_english",
     "reason": null,
     "language": "en",
     "model": null,
     "prompt_version": "1",
     "glossary_version": "d2d068ff5886",
     "version": "e1",
     "spans": null,
     "cached": false,
     "request": null
    },
    {
     "text": "# Ports\n\nThe search daemon listens on port 8791. The chat server listens on port 8787.",
     "status": "original_english",
     "reason": null,
     "language": "en",
     "model": null,
     "prompt_version": "1",
     "glossary_version": "d2d068ff5886",
     "version": "e1",
     "spans": null,
     "cached": false,
     "request": null
    },
    {
     "text": "# Decision: translation cache in the checkout\n\nThe translation cache is stored as a SQLite file inside the repository checkout.",
     "status": "original_english",
     "reason": null,
     "language": "en",
     "model": null,
     "prompt_version": "1",
     "glossary_version": "d2d068ff5886",
